{
    "name": "dagasmart/nestedset",
    "description": "Nested Set Model for Laravel 13 and up",
    "keywords": [
        "laravel",
        "nested sets",
        "nsm",
        "database",
        "hierarchy"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "dagasmart",
            "email": "dagasmart@qq.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": ">=13.0",
        "illuminate/database": ">=13.0",
        "illuminate/events": ">=13.0"
    },
    "autoload": {
        "psr-4": {
            "DagaSmart\\Nestedset\\": "src/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": ">=7.0"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-master": "v5.0.x-dev"
        },
        "laravel": {
            "providers": [
                "DagaSmart\\Nestedset\\NestedSetServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": [
            "@php ./vendor/bin/phpunit"
        ]
    }
}
